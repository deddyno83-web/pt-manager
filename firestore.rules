// firestore.rules
// Incolla queste regole in Firebase Console → Firestore → Regole → Pubblica.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Workout Log: ogni utente legge e scrive SOLO i propri dati
    // (presets, sessions, exercises, playlists).
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Vecchia app "PT Manager" (backup in pt-manager-backup-v1): lasciate
    // così com'erano, per non rompere i dati esistenti. Si possono cancellare
    // quando non servono più.
    match /clients/{clientId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
    match /appointments/{appointmentId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
  }
}
